<div class="body">
    <header>
        <div id="presentation">
            <img src="../fotos/fotoCV2.jpg" alt="">
            <h1>{{presentation.name}}</h1>
            <h3>{{presentation.titles}}</h3>
        </div>
        <div id="contacto">
            <div id="correo" class="dataContact">
                <img src="../iconos/correo-electronico.png" alt="">
                <p><a href="https://mail.google.com/mail/?view=cm&to=emidovichi@gmail.com&su=Hello,%20I%20saw%20your%20resume">emidovichi@gmail.com</a></p>
            </div>
            <div id="tel" class="dataContact">
                <img src="../iconos/whatsapp.png" alt="">
                <p><a href="https://wa.me/+5492664006000">+5492664006000</a></p>
            </div>
            <div id="linkedin" class="dataContact">
                <img src="../iconos/linkedin.png" alt="">
                <p><a href="https://www.linkedin.com/in/emiliano-dovichi/">linkedin.com/in/emiliano-dovichi</a></p>
            </div>
            <div id="github" class="dataContact">
                <img src="../iconos/github.png" alt="">
                <p><a href="https://github.com/Ing-ed">github.com/Ing-ed</a></p>
            </div>
        </div>
    </header>
    <div id="abstract" class="section">
        <h3>{{about.title}}</h3>
        <hr class="vhr">
        <p>{{about.descr}}</p>
    </div>
    <div id="experience" class="section">
        <h3>{{prof.title}}</h3>
        <hr>
        <i>{{prof.date}}</i>
        <p>{{prof.descr}}</p>
        <h4>{{prof.tech.title}}</h4>
        <ul id="techs">
        {{#each prof.tech.data}}
            <li>{{this}}</li>
        {{/each}}
        </ul>
        <div class="listas">
        {{#each prof.langs}}
            <p><strong>{{this.lang}}</strong></p>
            <ul>
                {{#each this.projs}}
                    {{#if this.nota}}
                    <li>{{this.nota}} <a href={{this.link}}>{{this.link}}</a> </li>
                    {{else}}
                    <li>
                        <p><b>{{this.title}}</b></p>
                        <p>{{this.descr}}</p>
                    </li>
                    {{/if}}
                {{/each}}
            </ul>
        {{/each}}
        </div>
    </div>
    {{!-- <div id="tecnologies" class="section"></div> --}}
    <div id="education" class="section">
        <h3>{{education.title}}</h3>
        {{!-- <p>{{education.relevant}}</p> --}}
        <hr>
        {{#each education.eds}}
            <p><strong>{{this.title}}</strong></p>
            <p><i>{{this.date}}</i></p>
            <p>{{this.stablish}}</p>
            <p>{{education.relevant}}</p>
            <ul>
                {{#each this.knows}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
            <br>
        {{/each}}
        
    </div>
    <div id="background" class="section">
        <h3>{{background.title}}</h3>
        <hr>
        <div id="jobs">
            {{#each background.jobs}}
                <div>
                    <p><strong>{{this.title}}</strong></p>
                    <p><i>{{this.date}}</i></p>
                    <p>{{this.descr}}</p>
                </div>
            {{/each}}
        </div>
    </div>
</div>