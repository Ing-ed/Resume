<div class="body">
    <header>
        <div id="presentation">
            <img src="../fotos/fotoCV2.jpg" alt="">
            <h1>{{presentation.name}}</h1>
            <h3>{{presentation.titles.engineer}}</h3>
        </div>
        <div id="contacto">
            <div id="correo" class="dataContact">
                <img src="../iconos/correo-electronico.png" alt="">
                <p><a href="https://mail.google.com/mail/?view=cm&to=emidovichi@gmail.com&su=Hello,%20I%20saw%20your%20resume">emidovichi@gmail.com</a></p>
            </div>
            <div id="tel" class="dataContact">
                <img src="../iconos/whatsapp.png" alt="">
                <p><a href="https://wa.me/+5492664006000">+5492664006000</a></p>
            </div>
            <div id="linkedin" class="dataContact">
                <img src="../iconos/linkedin.png" alt="">
                <p><a href="https://www.linkedin.com/in/emiliano-dovichi/">linkedin.com/in/emiliano-dovichi</a></p>
            </div>
            <div id="github" class="dataContact">
                <img src="../iconos/github.png" alt="">
                <p><a href="https://github.com/Ing-ed">github.com/Ing-ed</a></p>
            </div>
        </div>
    </header>
    <div id="abstract" class="section">
        <h3>{{about.title}}</h3>
        <hr class="vhr">
        {{#if clase}}
        <p>{{about.descr.engineer}}</p>
        {{else}}
        <p>{{about.descr.fullstack}}</p>
        {{/if}}
    </div>
    <div id="exps">
        <div id="experience" class="section">
            {{#if clase}}
            <h3 id="clase" name={{clase}}>{{prof.title.engineer}}</h3>
            {{else}}
            <h3 id="clase" name={{clase}}>{{prof.title.fullstack}}</h3>
            {{/if}}
            <hr>
            <i>{{prof.date}}</i>
            <p>{{prof.descr}}</p>
            <h4>{{prof.tech.title}}</h4>
            <ul id="techs">
            {{#each prof.tech.data}}
                <li>{{this}}</li>
            {{/each}}
            </ul>
            <div class="listas">
            {{#each prof.langs}}
                <p><strong>{{this.lang}}</strong></p>
                <ul>
                    {{#each this.projs}}
                        {{#if this.nota}}
                        <li>{{this.nota}} <a href={{this.link}}>{{this.link}}</a> </li>
                        {{else}}
                        <li>
                            <p><b>{{this.title}}</b></p>
                            <p>{{this.descr}}</p>
                        </li>
                        {{/if}}
                    {{/each}}
                </ul>
            {{/each}}
            </div>
        </div>
        <br>
        <div id="skills" class="section">
            <h3>{{skills.title}}</h3>
            <hr>
            <ul>
            {{#if clase}}
                {{#each skills.engineer.skills}}
                <p><b>{{this.title}}</b></p>
                <ul>
                    <li>
                        <p>{{this.descr}}</p>
                    </li>
                </ul>
                {{/each}}
            {{else}}
                {{#each skills.fullstack.skills}}
                <p><b>{{this.title}}</b></p>
                <ul>
                    <li>
                        <p>{{this.descr}}</p>
                    </li>
                </ul>
                {{/each}}
            {{/if}}
            </ul>
        </div>
        <br>
        {{!-- <div id="tecnologies" class="section"></div> --}}
        <div id="education" class="section">
            <h3>{{education.title}}</h3>
            {{!-- <p>{{education.relevant}}</p> --}}
            <hr>
            {{#each education.eds}}
                <p><strong>{{this.title}}</strong></p>
                <p><i>{{this.date}}</i></p>
                <p>{{this.stablish}}</p>
                <p>{{education.relevant}}</p>
                <ul>
                    {{#each this.knows}}
                        <li>{{this}}</li>
                    {{/each}}
                </ul>
                <br>
            {{/each}}
        </div>
        <br>
        <div id="background" class="section">
            {{#if clase}}
            <h3>{{background.title.engineer}}</h3>
            {{else}}
            <h3>{{background.title.fullstack}}</h3>
            {{/if}}
            <hr>
            <div id="jobs">
                {{#each background.jobs}}
                    <div>
                        <p><strong>{{this.title}}</strong></p>
                        <p><i>{{this.date}}</i></p>
                        <p>{{this.descr}}</p>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
<script>
    clase = document.getElementById("clase").getAttribute('name')
    if(clase === 'true'){
        document.getElementById('exps').style.flexDirection = 'column-reverse'
    }
</script>